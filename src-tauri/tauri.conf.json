{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cekcok IDE",
  "version": "0.2.6",
  "identifier": "com.cekcok.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cekcok IDE",
        "width": 1024,
        "height": 768,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://releases.cekcok.my.id/cekcok-releases/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4Q0JFN0IxRDY0RTNGOTAKUldTUVAwN1dzZWZMbUs3YkUvWHpCeVFwSCtiTkJ3ZWVMaHIwZGNvbUttc2Y2RXVqVG14VHpPcjAK"
    }
  }
}
